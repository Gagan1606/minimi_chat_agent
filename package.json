{
  "name": "momos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/cli.ts",
    "api:generate": "tsx src/contracts/v1/write-openapi.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "tsx --test test/**/*.test.ts",
    "format": "prettier --write src test eval tests/load ops/runbooks docs/release *.json compose.yaml .github/workflows/ci.yml README.md eslint.config.js infra/local/keycloak/momos-demo-realm.json docs/api docs/data-model.md",
    "format:check": "prettier --check src test eval tests/load ops/runbooks docs/release *.json compose.yaml .github/workflows/ci.yml README.md eslint.config.js infra/local/keycloak/momos-demo-realm.json docs/api docs/data-model.md",
    "providers:smoke": "tsx src/providers/smoke.ts",
    "tavily:smoke": "tsx src/providers/tavily-smoke.ts",
    "eval:staging": "node eval/run.mjs",
    "load:staging": "node tests/load/workspace-chat.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tavily/core": "^1.1.0",
    "dotenv": "^18.0.10",
    "openid-client": "^6.9.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
