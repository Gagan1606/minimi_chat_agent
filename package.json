{
  "name": "momos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/**/*.test.ts",
    "format": "prettier --write src test *.json",
    "format:check": "prettier --check src test *.json",
    "providers:smoke": "tsx src/providers/smoke.ts",
    "tavily:smoke": "tsx src/providers/tavily-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tavily/core": "^1.1.0",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
