# Momos environment template
# Fill the user-supplied values in this first section. Do not commit a real .env file.
# Production values belong in the deployment secret manager, not in source control.

# -----------------------------------------------------------------------------
# LOCAL OIDC DEVELOPMENT VALUES
# These match the development-only Keycloak realm in compose.yaml. Replace them
# with real provider values only in a secret manager when configuring staging.
# -----------------------------------------------------------------------------

# Dummy values for local Keycloak. They are not production credentials.
OIDC_ISSUER_URL=http://localhost:8080/realms/momos-demo
OIDC_CLIENT_ID=momos-local-placeholder
OIDC_CLIENT_SECRET=replace-me-later
OIDC_TRANSACTION_COOKIE_NAME=momos_oidc_transaction
OIDC_MFA_ACR_VALUES=

# Local seeded Platform Admin; the user must enroll a TOTP authenticator.
PLATFORM_ADMIN_BOOTSTRAP_ISSUER=http://localhost:8080/realms/momos-demo
PLATFORM_ADMIN_BOOTSTRAP_SUBJECT=11111111-1111-4111-8111-111111111111

# Model provider and model selection. API key/base URL depend on the selected provider.
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.5-flash-lite
MODEL_API_KEY=
MODEL_BASE_URL=

# Web-search provider. This is the agent's only exposed tool.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=

# Embedding provider/model. Set dimensions to the selected model's actual output size.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=

# Vector database. Set dimensions equal to EMBEDDING_DIMENSIONS.
VECTOR_STORE_PROVIDER=
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=
VECTOR_STORE_DIMENSIONS=

# Optional external observability collector. Leave blank to use local stdout/no exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# -----------------------------------------------------------------------------
# SAFE LOCAL DEVELOPMENT DEFAULTS
# These are convenience values for local development only. Replace database,
# URL, TLS, and proxy settings for a deployed environment.
# -----------------------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://localhost:3000
OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
OIDC_SCOPES=openid profile email
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-only-change-me
LOCAL_POSTGRES_USER=momos
LOCAL_POSTGRES_PASSWORD=momos
LOCAL_POSTGRES_DATABASE=momos
LOCAL_POSTGRES_HOST_PORT=15432

# Local Docker/PostgreSQL example only. Production must use managed credentials
# and encrypted connections. Use a separate migration role where available.
DATABASE_URL=postgresql://momos:momos@localhost:15432/momos
MIGRATION_DATABASE_URL=postgresql://momos:momos@localhost:15432/momos
DATABASE_SSL_MODE=disable
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000

# Session cookie defaults. Secure=false is only for localhost HTTP development;
# set true behind HTTPS in every deployed environment.
SESSION_COOKIE_NAME=momos_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400

# Application behavior and privacy-safe observability.
LOG_LEVEL=info
OTEL_SERVICE_NAME=momos
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Time budgets follow DESIGN.md's 10s total chat target; budgets may need tuning
# after providers are selected and measured.
MODEL_TIMEOUT_MS=10000
WEB_SEARCH_TIMEOUT_MS=4000
VECTOR_STORE_TIMEOUT_MS=1000

# Vector indexing worker defaults; PostgreSQL remains the system of record.
EMBEDDING_INDEXER_ENABLED=true
EMBEDDING_INDEXER_BATCH_SIZE=32
EMBEDDING_INDEXER_POLL_INTERVAL_MS=1000
EMBEDDING_INDEXER_MAX_ATTEMPTS=10
VECTOR_STORE_COLLECTION=momos-messages
VECTOR_STORE_METRIC=cosine

# Abuse-protection limits from SPEC.md. These are not product usage quotas.
RATE_LIMIT_STORE=postgres
RATE_LIMIT_OIDC_START_MAX=10
RATE_LIMIT_OIDC_START_WINDOW_SECONDS=900
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_READ_WINDOW_SECONDS=60
RATE_LIMIT_DELETE_MAX=10
RATE_LIMIT_DELETE_WINDOW_SECONDS=3600

# Backup schedule, encryption, and 30-day retention are configured on the
# managed database/hosting service, not by the application process.
